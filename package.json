{
   "name": "wasaby-cli",
   "version": "26.3200.0",
   "description": "Build and run unit tests for wasaby",
   "scripts": {
      "test": "jest --roots=test",
      "coverage": "jest --coverage"
   },
   "repository": {
      "type": "git",
      "url": "git@git.sbis.ru:saby/wasaby-cli.git"
   },
   "bin": {
      "wasaby-cli": "./cli.js"
   },
   "jest": {
      "roots": [
         "src",
         "test"
      ],
      "collectCoverageFrom": [
         "**/*.js"
      ],
      "coverageDirectory": "./coverage",
      "coverageReporters": [
         [
            "html",
            {
               "subdir": "coverage"
            }
         ]
      ]
   },
   "dependencies": {
      "@testing-library/react": "14.3.1",
      "@testing-library/dom": "9.3.4",
      "@testing-library/user-event": "14.5.2",
      "@types/jest": "29.5.12",
      "body-parser": "1.19.2",
      "cookie-parser": "1.4.6",
      "commander": "11.1.0",
      "es5-ext": "0.10.53",
      "express": "4.18.2",
      "fs-extra": "10.0.1",
      "glob": "7.2.0",
      "tree-kill": "1.2.2",
      "open": "8.4.0",
      "openssl-nodejs": "1.0.5",
      "p-map": "4.0.0",
      "spdy": "4.0.2",
      "xml2js": "0.4.23",
      "connect": "3.7.0",
      "jest": "29.7.0",
      "@jest/reporters": "29.7.0",
      "jest-junit": "13.0.0",
      "jest-environment-jsdom": "29.7.0",
      "jest-environment-node": "29.7.0",
      "jss": "10.9.0",
      "saby-typescript": "git+ssh://git@git.sbis.ru:saby/typescript.git#rc-26.3200",
      "saby-units": "git+ssh://git@git.sbis.ru:saby/units.git#rc-26.3200",
      "sbis3-builder": "git+ssh://git@git.sbis.ru:saby/builder.git#rc-26.3200"
   },
   "resolutions": {
      "es5-ext": "0.10.53"
   },
   "overrides": {
      "es5-ext": "0.10.53"
   }
}